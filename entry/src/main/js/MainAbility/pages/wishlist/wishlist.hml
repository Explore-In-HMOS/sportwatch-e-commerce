<div class="container">
    <list class="content-list">
        <list-item class="header-section">
            <div class="header">
                <text class="header-title">Favorites</text>
                <text class="header-sub">Your saved items</text>
            </div>
        </list-item>

        <list-item class="product-card" for="{{wishlistItems}}" onclick="openProduct({{$item.productId}})">
            <div class="card-inner">
                <div class="accent accent-pink"></div>
                <image class="product-img" src="{{$item.image}}"></image>
                <text class="product-name">{{$item.productTitle}}</text>
                <text class="product-price">${{$item.productPrice}}</text>
            </div>
        </list-item>

        <list-item class="empty-section" if="{{wishlistItems.length === 0}}">
            <div class="empty-state">
                <text class="empty-text">No items in wishlist</text>
            </div>
        </list-item>

        <list-item class="back-section" onclick="goBack">
            <div class="back-card">
                <div class="back-icon"></div>
                <text class="back-text">Back</text>
            </div>
        </list-item>

        <list-item class="spacer-item">
            <div class="spacer"></div>
        </list-item>
    </list>

    <div class="toast" if="{{showToast}}">
        <text class="toast-text">{{toastMsg}}</text>
    </div>
</div>
